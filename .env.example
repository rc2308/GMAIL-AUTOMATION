GATHER_PORT=3088
# Configure once for the application, not separately for every customer.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3088/api/oauth/google/callback
# Add this second redirect URI to the same Google OAuth Web application.
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:3088/api/auth/google/callback
